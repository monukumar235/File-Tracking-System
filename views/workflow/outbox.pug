extends ../layout/layout

block content

    .container.mt-4

        .d-flex.justify-content-between.align-items-center.mb-4

            h2 My Outbox

            a.btn.btn-secondary(href="/dashboard")
                | Dashboard

        .card.shadow

            .card-header.bg-primary.text-white

                h5.mb-0 Submitted Files

            .card-body

                table.table.table-hover

                    thead.table-dark

                        tr
                            th File No.
                            th Subject
                            th Current Owner
                            th Status
                        

                    tbody

                        if files && files.length

                            each file in files

                                tr

                                    td= file.fileNumber

                                    td= file.subject

                                    td= file.currentOwner ? `${file.currentOwner.name} (${file.currentOwner.role})` : "Completed"

                                    td
                                        if file.status === "APPROVED"
                                            span.badge.bg-success Approved
                                        else if file.status === "REJECTED"
                                            span.badge.bg-danger Rejected
                                        else if file.status === "IN_PROGRESS"
                                            span.badge.bg-warning.text-dark In Progress
                                        else
                                            span.badge.bg-primary= file.status


                        else

                            tr

                                td.text-center(colspan="5")
                                    | No Submitted Files Found