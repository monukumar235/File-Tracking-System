extends ../layout/layout

block content

    .d-flex.justify-content-between.align-items-center.mb-4

        h2 My Inbox

    .card.shadow

        .card-body

            table.table.table-hover

                thead.table-dark

                    tr
                        th File No.
                        th Subject
                        th From
                        th Status
                        th Action

                tbody

                    if files.length

                        each file in files

                            tr

                                td= file.fileNumber

                                td= file.subject

                                td= file.createdBy ? file.createdBy.name : "-"

                                td
                                    span.badge.bg-warning.text-dark= file.status

                                td

                                    a.btn.btn-sm.btn-info.me-1(
                                        href=`/workflow/view/${file._id}`
                                    ) View

                    else

                        tr
                            td.text-center(colspan="5")
                                | No Pending Files